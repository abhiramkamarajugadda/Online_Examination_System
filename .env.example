# Environment variables read by the app. Never commit real values.
# Local MySQL
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
# DB_URL=jdbc:mysql://localhost:3306/online_exam?createDatabaseIfNotExist=true

# Hosted MySQL such as Aiven (these override DB_*); Aiven needs SSL:
# SPRING_DATASOURCE_URL=jdbc:mysql://HOST:PORT/examsphere?sslMode=REQUIRED&createDatabaseIfNotExist=true
# SPRING_DATASOURCE_USERNAME=avnadmin
# SPRING_DATASOURCE_PASSWORD=your_aiven_password

# Admin login (local defaults are admin@examsphere.com / admin123)
ADMIN_EMAIL=admin@examsphere.com
ADMIN_PASSWORD=choose_a_strong_password

# Seed the sample exam and demo student on an empty database
DEMO_SEED=true
