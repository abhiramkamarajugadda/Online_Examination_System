<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html><head><title>${exam.title}</title><link rel="stylesheet" href="/css/style.css"></head><body><div class="exam-header"><h2>${exam.title}</h2><div>Time Left: <span id="timer">${exam.duration}:00</span></div></div><form id="f" action="/student/submit/${exam.id}" method="post"><main><c:forEach items="${questions}" var="q" varStatus="s"><div class="card"><h3>${s.count}. ${q.questionText}</h3><label><input type="radio" name="answer_${q.id}" value="A"> A. ${q.optionA}</label><label><input type="radio" name="answer_${q.id}" value="B"> B. ${q.optionB}</label><label><input type="radio" name="answer_${q.id}" value="C"> C. ${q.optionC}</label><label><input type="radio" name="answer_${q.id}" value="D"> D. ${q.optionD}</label></div></c:forEach><button class="btn full">Submit Examination</button></main></form><script>let t=${exam.duration}*60;setInterval(()=>{let m=Math.floor(t/60),s=t%60;document.getElementById('timer').textContent=m+':'+String(s).padStart(2,'0');if(--t<0)document.getElementById('f').submit()},1000);</script></body></html>