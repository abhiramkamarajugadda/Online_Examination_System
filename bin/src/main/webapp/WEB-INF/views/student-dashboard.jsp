<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html><head><title>Dashboard</title><link rel="stylesheet" href="/css/style.css"></head><body><nav><h2>ExamSphere</h2><a href="/logout">Logout</a></nav><main><h1>Welcome, ${user.fullName}</h1><div class="exam-grid"><c:forEach items="${exams}" var="e"><div class="card"><h2>${e.title}</h2><p>${e.subject}</p><p>${e.duration} Minutes | ${e.totalMarks} Marks</p><a class="btn" href="/student/exam/${e.id}">Start Exam</a></div></c:forEach></div></main></body></html>