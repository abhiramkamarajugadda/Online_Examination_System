<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html><head><title>Manage Exams</title><link rel="stylesheet" href="/css/style.css"></head><body><nav><h2>Manage Exams</h2><a href="/admin/dashboard">Dashboard</a></nav><main><table><tr><th>Title</th><th>Subject</th><th>Actions</th></tr><c:forEach items="${exams}" var="e"><tr><td>${e.title}</td><td>${e.subject}</td><td><a href="/admin/question/add/${e.id}">Add Question</a> | <a href="/admin/exam/delete/${e.id}">Delete</a></td></tr></c:forEach></table></main></body></html>